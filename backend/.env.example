DATABASE_URL=postgresql://postgres:1234@db:5432/hackathon_db
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_BACKEND=local
STORAGE_ROOT=storage
PUBLIC_BASE_URL=http://127.0.0.1:8000

COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_TIMEOUT_SECONDS=120
COMFYUI_MAX_WAIT_SECONDS=900

# 로컬 uvicorn 실행 시: postgresql://postgres:1234@127.0.0.1:5432/hackathon_db
# ComfyUI가 같은 머신에서 8188이면: COMFYUI_BASE_URL=http://127.0.0.1:8188

# 플롯 CLI는 torch 등이 필요합니다. hackerton 프로젝트에서: python3 -m venv .venv && .venv/bin/pip install -r requirements-plot.txt
PLOT_GENERATION_PYTHON=/Users/tykim/PycharmProjects/PythonProject/hackerton_2026_03_11_image_ai/hackerton_2026_03_11_image_ai/.venv/bin/python
PLOT_GENERATION_CLI=/Users/tykim/PycharmProjects/PythonProject/hackerton_2026_03_11_image_ai/hackerton_2026_03_11_image_ai/inference/generate_plot_cli.py

# 플롯용 베이스 모델(meta-llama/Llama-3.2-3B-Instruct)은 게이트 모델입니다.
# https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct 에서 약관 동의 후, https://huggingface.co/settings/tokens 에서 토큰 발급
# HF_TOKEN=hf_xxxxxxxx
# 403 Forbidden: 토큰만으로는 부족합니다. 모델 페이지에서 반드시 "약관 동의" 후 접근 허용됨
# https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
# 베이스 모델 전체를 로컬에 받은 경우(폴더에 config.json 있음) 허브 우회:
# PLOT_BASE_MODEL_LOCAL=/path/to/Llama-3.2-3B-Instruct
